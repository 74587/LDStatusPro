# LD士多本地开发环境变量示例
# 复制此文件为 .env.local。下列 API 地址在本地开发时应留空，由 Vite 同源代理分流。
# 生产构建已有默认公网地址；只有切换后端时才需要显式覆盖。

# API 路由配置
VITE_API_BASE=
VITE_AUTH_API_BASE=
VITE_IMAGE_API_BASE=

# 可选浏览器端基础设施（默认关闭；生产开启时采样率建议保持 0.1）
VITE_FARO_ENABLED=0
VITE_FARO_COLLECTOR_URL=
VITE_FARO_SESSION_SAMPLE_RATE=0.1
VITE_DEPLOYMENT_ENVIRONMENT=development
VITE_APP_VERSION=

# 维护模式开关（1=开启，0=关闭）
VITE_MAINTENANCE_MODE=0
VITE_MAINTENANCE_TITLE=LD士多维护中
VITE_MAINTENANCE_MESSAGE=正在进行数据迁移，请稍后再试。
VITE_MAINTENANCE_ETA=预计 10 分钟内恢复
VITE_MAINTENANCE_STATUS_URL=https://status.ldspro.qzz.io/status/ldstatus
