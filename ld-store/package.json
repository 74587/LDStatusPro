{
  "name": "ld-store",
  "version": "1.0.0",
  "description": "LD士多网页版 - LDC积分商城",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint . --ext .js,.vue --ignore-pattern dist --ignore-pattern node_modules --ignore-pattern .wrangler",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run lint && npm run test && npm run build && npm run validate:og",
    "build": "vite build",
    "validate:og": "node scripts/validate-open-graph.mjs",
    "build:private-metadata": "bash scripts/build-private-metadata.sh",
    "preview": "vite preview",
    "preview:tabs": "vite --config tests/fixtures/liquid-tabs-preview/vite.config.js",
    "deploy": "bash scripts/deploy-pages-production.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "2.10.0",
    "@grafana/faro-web-tracing": "2.10.0",
    "@lucide/vue": "^1.32.0",
    "dompurify": "^3.4.13",
    "echarts": "^6.1.0",
    "marked": "^18.0.2",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.0.0",
    "https-proxy-agent": "^9.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "terser": "^5.44.1",
    "vite": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
